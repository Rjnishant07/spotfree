PORT=4000
FRONTEND_URL=http://localhost:3000

# Postgres (free: neon.tech or supabase.com). Set DATABASE_SSL=true for hosted DBs.
DATABASE_URL=postgres://user:pass@localhost:5432/spotfree
DATABASE_SSL=false

# Secrets: generate each with `openssl rand -hex 32`
OTP_SECRET=change-me
SESSION_SECRET=change-me-too

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=SpotFree <onboarding@resend.dev>

# Comma-separated. These emails become Admin accounts on boot.
ADMIN_EMAILS=you@yourdomain.com
# Campus clock used for booking hours, timetable and the 6 PM rule
APP_TIMEZONE=Asia/Kolkata
# Emails allowed to self-register as Student
ALLOWED_EMAIL_DOMAINS=heritageit.edu,heritageit.edu.in
